# Copy to .env and fill in. Leave an integration's lines empty to disable it.

# Supabase: Project Settings -> API Keys. Use the *secret* key (sb_secret_...).
# Keep it only on the Pi; it bypasses all access rules.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=

# IKEA DIRIGERA hub: run `npm run pair-dirigera -- <hub IP>` and press the
# button on the bottom of the hub; it saves these two lines for you.
DIRIGERA_HOST=
DIRIGERA_TOKEN=

# The older IKEA TRÅDFRI gateway (leave empty once you use DIRIGERA): run `npm run pair-tradfri -- <code under the gateway>`
# and paste the three lines it prints.
TRADFRI_HOST=
TRADFRI_IDENTITY=
TRADFRI_PSK=

# Honeywell evohome isn't configured here: it runs in Supabase (see README).

# Eufy: ideally a second account the doorbell is shared with.
EUFY_USERNAME=
EUFY_PASSWORD=
# Two-letter country code of the Eufy account, e.g. NL, DE, GB, US
EUFY_COUNTRY=
# Only when the agent log asks for them (first login):
EUFY_VERIFY_CODE=
EUFY_CAPTCHA_ID=
EUFY_CAPTCHA_CODE=

# Brel Home blinds: the 16-character key from the Brel Home app
# ("Me" -> tap the version number 5 times on iOS, or right of the photo on Android).
BREL_KEY=
# The hub's IP address; leave empty to find it automatically.
BREL_HOST=
# Optional names per blind (mac=name, comma-separated). `npm run discover` lists the macs.
BREL_NAMES=

# Sony BRAVIA TV: its IP address, and the Pre-Shared Key set on the TV under
# Settings -> Network & Internet -> Home network -> IP control.
BRAVIA_HOST=
BRAVIA_PSK=

# Sonos: no key needed. Set SONOS=on, or SONOS_HOST to a speaker's IP address
# (speakers are also found automatically).
SONOS=
SONOS_HOST=

# Apple TV / HomePod (needs pyatv in ~/.local/pyatv and a one-time pairing,
# see README). Names as in the Home app, comma-separated.
APPLE_DEVICES=
# Optional names in the app, e.g. Woonkamer=Apple TV,Kantoor=HomePod
APPLE_NAMES=

# Roborock vacuum (S5 and other miIO models): its IP and 32-character token.
ROBOROCK_HOST=
ROBOROCK_TOKEN=
ROBOROCK_NAME=Roborock

# Custom ESP32 IKEA OBEGRÄNSAD display (not a DIRIGERA accessory).
# LAN hostname/IP only; use a DHCP reservation. Disable its Scheduled brightness
# before controlling it through home automations. No OTA password is required.
IKEA_DISPLAY_HOST=
IKEA_DISPLAY_NAME=IKEA display
IKEA_DISPLAY_ROOM=

# Devices only watched on the network, awake or asleep (e.g. a game console):
# PRESENCE_DEVICES=Steam machine=192.168.1.20
PRESENCE_DEVICES=
